Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  portability-*
WarningsAsErrors: '*'
# The .hpp files directly in a directory whose name starts with zeta-daw: the
# repository root. clang-tidy's regular expressions have no lookahead.
HeaderFilterRegex: '[/\\]zeta-daw[^/\\]*[/\\][^/\\]+\.hpp$'
